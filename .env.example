# Copy to .env (or .env.production) and fill in. Values are baked in at build time.

# Public URL of this marketing site. Used for canonical links, Open Graph tags and sitemap.xml.
VITE_SITE_URL=https://hexalabs.online

# Where the "Book a demo" form POSTs its JSON payload.
# Leave empty and the form opens the visitor's email app addressed to support@hexalabs.online.
# Any JSON endpoint works (your own API, Formspree, Basin, an n8n webhook).
VITE_DEMO_ENDPOINT=
