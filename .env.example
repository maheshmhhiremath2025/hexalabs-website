# Copy to .env (or .env.production) and fill in. Values are baked in at build time.

# Public URL of this marketing site. Used for canonical links, Open Graph tags and sitemap.xml.
VITE_SITE_URL=https://hexalabs.online

# Where the "Book a demo" form POSTs its JSON payload. Leave empty to use the site's own
# /api/lead function (emails kumar@hexalabs.online).
VITE_DEMO_ENDPOINT=

# ── Server-side secrets for the /api functions (set in Vercel → Settings → Environment
# Variables; for local dev put them in .env.local, which is never committed) ──
# Hexa website assistant (api/hexa-chat.js)
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
HEXA_MODEL=
# Lead emails (api/lead.js). Microsoft 365 via Graph (preferred; sends as MAIL_SENDER, lands in the inbox):
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_SENDER=support@hexalabs.online
# Gmail fallback (a Gmail account with 2-step verification + a 16-character app password):
GMAIL_USER=
GMAIL_APP_PASSWORD=
